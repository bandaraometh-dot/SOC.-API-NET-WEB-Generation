@page
@model AboutModel
@{
    ViewData["Title"] = "About";
}

<style>
    .page-hero {
        background: linear-gradient(135deg, #0A0A0A, #001a3a);
        padding: 5rem 2rem 4rem;
        text-align: center;
        border-bottom: 1px solid var(--border);
    }
    .page-hero h1 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: 4px;
    }
    .page-hero h1 span { color: var(--blue); }
    .page-hero p { color: var(--grey); font-size: 1.1rem; margin-top: 1rem; }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }
    @@media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; } }
    .about-text h2 {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 2.2rem;
        letter-spacing: 2px;
        margin-bottom: 1rem;
    }
    .about-text h2 span { color: var(--blue); }
    .about-text p { color: var(--grey); margin-bottom: 1rem; line-height: 1.8; }
    .about-visual {
        background: var(--black-2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 3rem;
        text-align: center;
    }
    .about-visual i { font-size: 5rem; color: var(--blue); }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }
    .value-card {
        background: var(--black-2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 2rem;
        border-top: 3px solid var(--blue);
    }
    .value-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
    .value-card p { color: var(--grey); font-size: 0.95rem; }
</style>

<div class="page-hero">
    <h1>ABOUT <span>US</span></h1>
    <p>The story behind Kandy's most iconic sports club</p>
</div>

<section class="section">
    <div class="container">
        <div class="about-grid">
            <div class="about-text">
                <h2>OUR <span>STORY</span></h2>
                <p>Kandy Sports Club has been at the heart of sporting excellence in the Central Province for over three decades. Founded with a passion for nurturing local talent, we have grown into one of Sri Lanka's most respected sports institutions.</p>
                <p>From grassroots training to national-level competition, our facilities and coaching staff provide everything an athlete needs to reach their full potential.</p>
                <a asp-page="/Contact" class="btn btn-primary" style="margin-top:1rem;">Get In Touch</a>
            </div>
            <div class="about-visual">
                <i class="fas fa-trophy"></i>
                <p style="margin-top:1rem; font-family:'Bebas Neue'; font-size:1.5rem; letter-spacing:2px;">PRIDE OF KANDY</p>
            </div>
        </div>
    </div>
</section>

<section class="section" style="background: var(--black-3);">
    <div class="container">
